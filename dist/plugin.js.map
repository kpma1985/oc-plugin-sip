      "placeholder": "100"
    },
    "inbound.agentId": {
      "label": "OpenClaw Agent",
      "help": "Agent ID for voice.engine openclaw and OpenClaw tool delegation from deepgram-agent. Not the Deepgram agent's own LLM model."
    },
    "transport": {
