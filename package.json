{
  "name": "oc-plugin-sip",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/plugin.js",
  "files": [
    "dist/plugin.js",
    "dist/control-ui/controlUi.js",
    "dist/control-ui/controlUi.css",
    "openclaw.plugin.json",
    "vendor/sip-bridge/LICENSE",
    "vendor/sip-bridge/UPSTREAM.md"
  ],
  "description": "Independent SIP telephony channel plugin for OpenClaw: embedded SIP UAS + RTP, any SIP trunk (sipgate, ...), mu-law media over WebSocket, no Twilio/LiveKit dependency.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.vendor-lib.json && tsc --noEmit",
    "typecheck:vendor": "tsc --noEmit -p tsconfig.vendor.json",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "g722-spandsp": "^1.0.1",
    "pino": "^10.3.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.2",
    "openclaw": "2026.9.9",
    "typescript": "^6.0.3",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.9"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/plugin.js"
    ],
    "channel": {
      "id": "sip",
      "label": "SIP Telephony",
      "docsPath": "https://github.com/kpma1985/oc-plugin-sip/blob/main/README.md",
      "blurb": "Inbound voice over your own SIP trunk."
    },
    "compat": {
      "pluginApi": ">=2026.9.9",
      "minGatewayVersion": "2026.9.9"
    }
  },
  "homepage": "https://github.com/kpma1985/oc-plugin-sip",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kpma1985/oc-plugin-sip.git"
  },
  "bugs": {
    "url": "https://github.com/kpma1985/oc-plugin-sip/issues"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "g722-spandsp@1.0.1": true
  }
}
