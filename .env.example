# Placeholders only - never commit real credentials.
# For transport "bridge" only MEDIA_PORT and the gateway URL are needed; the
# SIP credentials live in the gateway (sipgate-sip-stream-bridge .env).

# --- media path (this plugin) ---
MEDIA_HOST=127.0.0.1
MEDIA_PORT=8080
MEDIA_PATH=/sip/media

# --- audio ---
AUDIO_MODE=twilio            # twilio = PCMU/mu-law 8 kHz, best = G.722 > PCMA > PCMU

# --- embedded SIP transport (only for transport=embedded) ---
SIP_USER=
SIP_PASSWORD=
SIP_DOMAIN=sipconnect.sipgate.de
SIP_REGISTRAR=sipconnect.sipgate.de
SIP_PUBLIC_IP=               # mandatory behind NAT: public IP for SDP Contact/Via
RTP_PORT_MIN=10000
RTP_PORT_MAX=10099

# --- inbound policy ---
INBOUND_POLICY=allowlist
INBOUND_ALLOW_FROM=
INBOUND_MAX_CONCURRENT=2
